# COMO USAR: faça uma COPIA deste arquivo com o nome config.env e preencha.
# Escreva cada valor na mesma linha, SEM aspas, SEM espaços sobrando e sem os símbolos # e $ dentro dos valores.
# NUNCA envie o config.env para o GitHub nem para ninguém (ele guarda suas senhas).

# Invente uma sequência longa e aleatória (30+ letras e números). O n8n usa para proteger suas credenciais.
N8N_ENCRYPTION_KEY=troque-por-uma-sequencia-longa-e-aleatoria-1234567890

# Chave da API da Anthropic (console.anthropic.com), começa com sk-ant-
ANTHROPIC_API_KEY=sk-ant-COLE-AQUI

# Instagram (API com Instagram Login)
IG_ACCESS_TOKEN=COLE-AQUI-O-TOKEN-GERADO-NO-PAINEL-DA-META
IG_USER_ID=COLE-AQUI-O-ID-NUMERICO-DA-CONTA
IG_USERNAME=usuario_da_anna_sem_arroba
GRAPH_HOST=graph.instagram.com
GRAPH_VERSION=v26.0

# Informações que a IA pode usar para responder comentários (uma linha só, sem inventar nada que não seja verdade)
INFO_ATENDIMENTO=Atendimento veterinário domiciliar para cães e gatos, com ênfase em medicina felina. Agendamentos pelo WhatsApp (XX) XXXXX-XXXX. Regiões atendidas: PREENCHER. Horários: PREENCHER.
