{
  "name": "2 - Postagem aprovada (Instagram Anna)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "77edb371-da71-4d79-a1f4-87ef22ba736a",
      "name": "A cada 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "conteudos"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "aprovado"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "id": "3c22d359-bd71-4b8c-87aa-2df28ffce730",
      "name": "Buscar post aprovado",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "b8287724-de75-467d-a7ee-2eaf9a9f5ba6",
              "leftValue": "={{ $json.image_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "789f0146-ebdd-457d-a886-77d09d3b5dba",
      "name": "Tem imagem?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.GRAPH_HOST }}/{{ $env.GRAPH_VERSION }}/{{ $env.IG_USER_ID }}/media",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $json.image_url }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.legenda }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.IG_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "da8f78f3-4d41-430a-8713-700e3d553226",
      "name": "Criar container de midia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -80
      ]
    },
    {
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
      "id": "6bbdd0d2-fd8c-494f-ac79-8b060d195fc5",
      "name": "Aguardar processamento",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        880,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.GRAPH_HOST }}/{{ $env.GRAPH_VERSION }}/{{ $env.IG_USER_ID }}/media_publish",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $('Criar container de midia').item.json.id }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.IG_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fe4bb7e1-5231-4873-b304-a1bf7c91e46b",
      "name": "Publicar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -80
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "conteudos"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "codigo",
              "condition": "eq",
              "keyValue": "={{ $('Buscar post aprovado').item.json.codigo }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "publicado",
            "publicado_em": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        }
      },
      "id": "b67a34a0-c643-4a14-b86f-cf6f42d9d2da",
      "name": "Marcar como publicado",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1320,
        -80
      ]
    }
  ],
  "connections": {
    "A cada 30 min": {
      "main": [
        [
          {
            "node": "Buscar post aprovado",
