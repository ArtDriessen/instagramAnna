            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tem imagem?": {
      "main": [
        [
          {
            "node": "Criar container de midia",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Criar container de midia": {
      "main": [
        [
          {
            "node": "Aguardar processamento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aguardar processamento": {
      "main": [
        [
          {
            "node": "Publicar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publicar": {
      "main": [
        [
          {
            "node": "Marcar como publicado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
