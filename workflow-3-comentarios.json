{
  "name": "3 - Comentarios (Instagram vet felina)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "8592078a-4937-4573-a406-54fe96e71aa8",
      "name": "A cada 10 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/{{ $env.GRAPH_VERSION }}/{{ $env.IG_USER_ID }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,caption,comments.limit(25){id,text,username,timestamp}"
            },
            {
              "name": "limit",
              "value": "10"
            },
            {
              "name": "access_token",
              "value": "={{ $env.IG_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "0eb0818e-3e08-4053-a48b-104d613c2e4f",
      "name": "Buscar posts e comentarios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst sd = $getWorkflowStaticData('global');\nsd.seen = sd.seen || {};\nconst minhaConta = ($env.IG_USERNAME || '').toLowerCase();\nconst novos = [];\nfor (const item of $input.all()) {\n  const medias = item.json.data || [];\n  for (const m of medias) {\n    const comentarios = (m.comments && m.comments.data) || [];\n    for (const c of comentarios) {\n      if (sd.seen[c.id]) continue;\n      sd.seen[c.id] = Date.now();\n      if (minhaConta && (c.username || '').toLowerCase() === minhaConta) continue;\n      novos.push({ json: { comment_id: c.id, username: c.username, texto: c.text, post_legenda: (m.caption || '').slice(0, 300), data: c.timestamp } });\n    }\n  }\n}\nconst limite = Date.now() - 14 * 24 * 3600 * 1000;\nfor (const k of Object.keys(sd.seen)) { if (sd.seen[k] < limite) delete sd.seen[k]; }\n// primeira execução: só registra o que já existe, para não responder comentários antigos\nif (!sd.initialized) { sd.initialized = true; return []; }\nreturn novos;\n"
      },
      "id": "d0df3344-e92c-42ec-b2b1-98b1dac2d95c",
      "name": "Achar comentarios novos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const SYSTEM = \"Voc\\u00ea escreve para o Instagram de uma cl\\u00ednica veterin\\u00e1ria especializada em felinos (gatos), no Brasil. Tom: acolhedor, claro e respons\\u00e1vel, para tutores leigos. Portugu\\u00eas do Brasil. No m\\u00e1ximo 2 emojis. Regras: nunca diagnostique nem prescreva; nunca indique medicamentos ou doses (v\\u00e1rios rem\\u00e9dios humanos s\\u00e3o perigosos para gatos); n\\u00e3o prometa cura; n\\u00e3o cite pre\\u00e7os nem promo\\u00e7\\u00f5es; n\\u00e3o critique outros profissionais. Em sinais de emerg\\u00eancia (dificuldade para respirar, tentativas de urinar sem sucesso, convuls\\u00e3o, sangramento, v\\u00f4mitos repetidos, apatia intensa, suspeita de intoxica\\u00e7\\u00e3o), oriente atendimento veterin\\u00e1rio imediato. Termine com um convite suave para agendar consulta. Sua tarefa agora \\u00e9 classificar um coment\\u00e1rio de seguidor e sugerir uma resposta curta (m\\u00e1x. 300 caracteres), cordial, sem conselho cl\\u00ednico individual. Informa\\u00e7\\u00f5es da cl\\u00ednica para usar nas respostas: PREENCHER_COM_HORARIO_ENDERECO_E_WHATSAPP_DA_CLINICA. Categorias: elogio, duvida_simples (hor\\u00e1rio, endere\\u00e7o, se atendem gatos, como agendar), duvida_clinica (sintomas, rem\\u00e9dios, comportamento do gato do seguidor), reclamacao, emergencia, spam, outro. Responda SOMENTE com JSON v\\u00e1lido: {\\\"categoria\\\": \\\"...\\\", \\\"resposta\\\": \\\"...\\\"}. Para duvida_clinica e emergencia, a resposta deve orientar consulta veterin\\u00e1ria e convidar para o WhatsApp, sem dar orienta\\u00e7\\u00e3o cl\\u00ednica.\";\n\nreturn $input.all().map(it => ({ json: {\n  ...it.json,\n  body: {\n    model: \"claude-sonnet-5-5\",\n    max_tokens: 500,\n    system: SYSTEM,\n    messages: [{ role: 'user', content: `Post: ${it.json.post_legenda}\\nComentário de @${it.json.username}: ${it.json.texto}` }]\n  }\n}}));\n"
      },
      "id": "aec35696-ceb7-4ad2-8145-f5cf3cb5c22e",
      "name": "Montar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "32ee3d71-97aa-4dfb-85bc-d170ab127292",
      "name": "Classificar e sugerir resposta (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nreturn items.map((it, i) => {\n  const ctx = $('Montar pedido').all()[i].json;\n  let d;\n  try {\n    const t = it.json.content[0].text;\n    d = JSON.parse(t.slice(t.indexOf('{'), t.lastIndexOf('}') + 1));\n  } catch (e) { d = { categoria: 'outro', resposta: '' }; }\n  const automaticas = ['elogio', 'duvida_simples'];\n  const auto = automaticas.includes(d.categoria) && !!d.resposta;\n  return { json: {\n    comment_id: ctx.comment_id, username: ctx.username, texto: ctx.texto, data: ctx.data,\n    categoria: d.categoria, resposta: d.resposta || '', auto\n  }};\n});\n"
      },
      "id": "1e2fea78-b04b-4bfd-8c7f-132c60ddc979",
      "name": "Interpretar resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
