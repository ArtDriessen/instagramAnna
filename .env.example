# Copie este arquivo para ".env" e preencha. NUNCA suba o ".env" para o GitHub.

# Chave para o n8n criptografar suas credenciais (gere com: openssl rand -hex 24)
N8N_ENCRYPTION_KEY=troque-por-um-valor-aleatorio-longo

# Anthropic (Claude) - https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Instagram / Meta Graph API
IG_USER_ID=ID_da_conta_instagram_profissional
IG_ACCESS_TOKEN=token_de_longa_duracao
IG_USERNAME=seu_usuario_sem_arroba
GRAPH_VERSION=v22.0
